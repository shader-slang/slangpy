+    void declareAllForCompute(MTL::ComputeCommandEncoder* encoder)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        std::vector<MTL::Resource*> resources;
+        for (const auto& [address, entry] : m_baseAddrMap)
+        {
+            for (BufferImpl* buffer = entry.head; buffer; buffer = buffer->m_nextAtSameAddr)
+                resources.push_back(buffer->m_buffer.get());
+        }
+        if (!resources.empty())
+            encoder->useResources(resources.data(), resources.size(), MTL::ResourceUsageRead | MTL::ResourceUsageWrite);
+    }
