import coverage_color;

// Fit the exposed luminance to a middle-gray target. Only exposure is differentiated.
[Differentiable]
float exposureLoss(float exposure, no_diff float light)
{
    float error = exposure * light - 0.45;
    return 0.5 * error * error;
}

float3 adjustExposure(float3 color, float exposure)
{
    // A bounded gradient step brightens dark pixels and reduces overexposure.
    // The derivative is generated by Slang and contributes to the output image.
    let loss = fwd_diff(exposureLoss)(diffPair(exposure, 1.0), luminance(color));
    float fittedExposure = clamp(exposure - 0.25 * loss.d, 0.25, 4.0);
    return color * fittedExposure;
}
